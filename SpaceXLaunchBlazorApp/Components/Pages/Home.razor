@page "/"
@using SpaceXLaunchBlazorApp.Models
@using SpaceXLaunchBlazorApp.Services
@inject LaunchLibraryService LaunchService

<PageTitle>SpaceX Launches</PageTitle>

<header class="bg-gradient-to-r from-gray-900 to-gray-800 text-white py-4 shadow-lg mb-10 flex items-center justify-between px-6">
    <h1 class="text-3xl md:text-4xl font-bold">Upcoming SpaceX Launches</h1>
    <span class="text-gray-300 hidden md:inline">All times shown in Eastern Time</span>
</header>

@if (launches == null || !launches.Any())
{
    <p class="text-center text-gray-500">Loading launches...</p>
}
else
{
    <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3">
    @foreach (var launch in launches)
    {
         var countdown = GetCountdown(launch.Net);
        <div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300">
            <img src="@GetLaunchImage(launch)" alt="@launch.Name" class="w-full h-48 object-cover" />
            <div class="p-6">
                <h2 class="text-lg font-semibold mb-1">@launch.Name</h2>
                <p class="text-sm text-gray-600 mb-3">@launch.Mission?.Description</p>
                <div class="text-sm space-y-1">
                    <p><span class="font-medium">Launch Pad:</span> @launch.Pad?.Location?.Name</p>
                    <p><span class="font-medium">Launch Date:</span> @GetEasternTimeString(launch.Net)</p>
                </div>
                @if (countdown == "Launched")
                {
                    <span class="inline-block bg-gray-400 text-white px-3 py-1 rounded-full text-xs font-semibold">
                        Launched
                    </span>
                }
                else if (IsLaunchSoon(launch.Net))
                {
                    <span class="inline-block bg-red-500 text-white px-3 py-1 rounded-full text-xs font-semibold">
                        Launching Soon
                    </span>
                }
                else
                {
                    <p class="font-mono text-sm text-gray-900 bg-gray-100 rounded px-2 py-1 inline-block mb-3">
                        Countdown: @countdown
                    </p>
                }
            </div>
        </div>
    }
    </div>
}

@code
{
    private List<Launch> launches = new();
    
    private PeriodicTimer? _ticker;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        launches = await LaunchService.GetUpcomingSpaceXLaunchesAsync();

        _cts = new CancellationTokenSource();
        _ticker = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _ = RunTickerAsync(_cts.Token);
    }

    public void Dispose() {
        _cts?.Cancel();
        _ticker?.Dispose();
        _cts?.Dispose();
    }

    private string GetEasternTimeString(DateTimeOffset? net)
    {
        if (!net.HasValue) return "TBD";
        var tzId = OperatingSystem.IsWindows() ? "Eastern Standard Time" : "America/New_York";
        var tz = TimeZoneInfo.FindSystemTimeZoneById(tzId);
        return TimeZoneInfo.ConvertTime(net.Value.UtcDateTime, TimeZoneInfo.Utc, tz)
                             .ToString("yyyy-MM-dd hh:mm tt");
    }

    private string GetCountdown(DateTimeOffset? net)
    {
        if (!net.HasValue) return "TBD";
        var remaining = net.Value - DateTimeOffset.UtcNow;
        if (remaining.TotalSeconds <= 0) return "Launched";
        return $"{remaining.Days}d {remaining.Hours}h {remaining.Minutes}m {remaining.Seconds}s";
    }

    private async Task RunTickerAsync(CancellationToken token)
    {
        if (_ticker == null) return;

        try
        {
            while (await _ticker.WaitForNextTickAsync(token))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Timer was canceled, exit gracefully
        }
    }

    private bool IsLaunchSoon(DateTimeOffset? net)
        => net.HasValue && (net.Value - DateTimeOffset.UtcNow).TotalMinutes <= 60;

    private string GetLaunchImage(Launch launch)
        => launch.Image?.ThumbnailUrl ?? "/images/F9_2_mobile.jpg";
}
